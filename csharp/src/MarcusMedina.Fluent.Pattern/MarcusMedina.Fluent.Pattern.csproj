<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>MarcusMedina.Fluent.Pattern</RootNamespace>
    <PackageId>MarcusMedina.Fluent.Pattern</PackageId>
    <Version>1.0.0</Version>
    <Authors>Marcus Medina</Authors>
    <Company>MarcusMedinaPro</Company>
    <Description>Fluent pattern matching extensions for strings — SQL-style LIKE, IN, BETWEEN without the SQL</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MarcusMedinaPro/MarcusMedina.Fluent.Pattern</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MarcusMedinaPro/MarcusMedina.Fluent.Pattern</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>fluent;pattern;like;string;extensions;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\assets\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\..\assets\open-source.svg" Pack="true" PackagePath="assets\" />
  </ItemGroup>
</Project>
